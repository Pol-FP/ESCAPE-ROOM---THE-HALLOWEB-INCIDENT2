# SIMULACIÓ DIDÀCTICA: política definida per a aquesta pràctica, no universal.
CSV_REQUIRED_COLUMNS=IP,Amenaca,Nivell,Port_Infectat
CRITICAL_PORTS=22,443,3389
TRANSPORT=tcp
NON_CRITICAL_ACTION=skip
DEFAULT_MODE=dry-run
# Una fila representa un host i un port. Mateixa IP amb ports diferents: files diferents.
# El fitxer és una pista per inspeccionar; no cal executar-lo ni carregar-lo amb source.
